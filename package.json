{
  "name": "candycapture-invoice-app",
  "version": "1.0.0",
  "description": "CandyCapture Photography Invoice Application - Multi-platform billing and invoice management system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/web",
    "packages/electron",
    "packages/backend"
  ],
  "scripts": {
    "dev": "npm run dev -w @candycapture/web",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @candycapture/web",
    "build:electron": "npm run build -w @candycapture/electron",
    "build:backend": "npm run build -w @candycapture/backend",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test -w @candycapture/web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
  },
  "keywords": [
    "invoice",
    "photography",
    "billing",
    "electron",
    "react",
    "aws"
  ],
  "author": "CandyCapture Photography",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.2"
  }
}
