{
  "name": "@candycapture/backend",
  "version": "1.0.0",
  "description": "CandyCapture Photography Invoice Application - AWS Backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/**/*.ts --bundle --platform=node --target=node18 --outdir=dist --format=esm --external:@aws-sdk/*",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "deploy": "cdk deploy --all",
    "synth": "cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.529.1",
    "@aws-sdk/lib-dynamodb": "^3.529.1",
    "@aws-sdk/client-s3": "^3.529.1",
    "@aws-sdk/client-cognito-identity-provider": "^3.529.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.136",
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "aws-cdk": "^2.133.0",
    "aws-cdk-lib": "^2.133.0",
    "constructs": "^10.3.0",
    "esbuild": "^0.20.1",
    "vite": "^5.1.6",
    "vitest": "^1.3.1",
    "rimraf": "^5.0.5"
  }
}
